generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  password         String
  avatar           String?   // Base64 Image
  
  // Birth Info
  birthDate        String?
  birthTime        String?
  birthCity        String?
  sign             String?
  
  // Core Economy
  diamonds         Int       @default(0) // Elmas Miktarı
  xp               Int       @default(0)
  level            Int       @default(1)
  
  // Gamification
  streak           Int       @default(0)
  lastLoginDate    String?   // Format: YYYY-MM-DD
  badges           String[]  @default([])
  
  // Auth & Security
  resetToken       String?
  resetTokenExpiry DateTime?
  
  // Relations
  inventory        UserInventory[]
  transactions     Transaction[]
  
  // New Relations (Phase 1)
  tarotReadings    TarotReading[]
  journalEntries   JournalEntry[]
  chatSessions     ChatSession[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}


model Product {
  id            String   @id @default(uuid())
  code          String   @unique // Programmatic identifier (e.g. 'citrine_necklace')
  name          String
  description   String
  priceTL       Float    @default(0)
  priceDiamonds Int      @default(0)
  image         String
  category      String   // 'crystal', 'ritual', 'digital'
  isDigital     Boolean  @default(false)
  
  inventoryItems UserInventory[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int      // Positive (earn) or Negative (spend)
  type        String   // 'DAILY_REWARD', 'PURCHASE', 'ADMIN_GIFT'
  description String
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserInventory {
  id          String   @id @default(uuid())
  userId      String
  productId   String
  purchasedAt DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

// --- Phase 1: New Models ---

model TarotReading {
  id             String   @id @default(uuid())
  userId         String
  question       String?
  spreadType     String   // 'single', 'three_card'
  cards          Json     // Array of card objects { id, name, position, reversed }
  interpretation String   @db.Text
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String
  mood      String?  // 'happy', 'sad', 'energetic'
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      String      // 'user', 'assistant'
  content   String      @db.Text
  createdAt DateTime    @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
