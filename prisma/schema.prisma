generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  password         String
  
  // Core Economy
  diamonds         Int       @default(0) // Elmas Miktarı
  xp               Int       @default(0)
  level            Int       @default(1)
  
  // Gamification
  streak           Int       @default(0)
  lastLoginDate    String?   // Format: YYYY-MM-DD
  badges           String[]  @default([])
  
  // Auth & Security
  resetToken       String?
  resetTokenExpiry DateTime?
  
  // Relations
  inventory        UserInventory[]
  transactions     Transaction[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Product {
  id            String   @id @default(uuid())
  code          String   @unique // Programmatic identifier (e.g. 'citrine_necklace')
  name          String
  description   String
  priceTL       Float    @default(0)
  priceDiamonds Int      @default(0)
  image         String
  category      String   // 'crystal', 'ritual', 'digital'
  isDigital     Boolean  @default(false)
  
  inventoryItems UserInventory[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int      // Positive (earn) or Negative (spend)
  type        String   // 'DAILY_REWARD', 'PURCHASE', 'ADMIN_GIFT'
  description String
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
}

model UserInventory {
  id          String   @id @default(uuid())
  userId      String
  productId   String
  purchasedAt DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}
